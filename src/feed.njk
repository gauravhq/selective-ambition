---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}: {{ site.subtitle }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.description }}</description>
    <language>en</language>
    <copyright>{{ site.author }}</copyright>
    {#- Republished posts (lib/republish.js) get a NEW guid per republish so readers see them again;
        every other item keeps its permalink guid, so subscribers are never re-sent the back catalogue. #}
    {% if collections.posts.length %}<lastBuildDate>{{ (collections.posts[0].url | rp).effective | rssDate }}</lastBuildDate>{% endif %}
    {% for post in collections.posts %}{% set rpi = post.url | rp %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      {% if rpi.cycle > 0 %}<guid isPermaLink="false">{{ site.url }}{{ post.url }}#republished-{{ rpi.effective | isoDay }}</guid>{% else %}<guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>{% endif %}
      <pubDate>{{ rpi.effective | rssDate }}</pubDate>
      <description>{% if rpi.label == "archive" %}From the archive: {% endif %}{{ post.data.pageDescription }}</description>
      <content:encoded><![CDATA[{{ post.templateContent | safe }}{% for r in rpi.revisits %}<h2>Revisited, {{ r.date | monthYear }}</h2>{{ r.html | absolutize(site.url) | safe }}{% endfor %}<p>From <em>{{ site.title }}: {{ site.subtitle }}</em> by {{ site.author }}. {% if rpi.cycle > 0 %}First published {{ rpi.published | readableDate }}. {% endif %}<a href="{{ site.url }}{{ post.url }}">Read the original</a>.</p>]]></content:encoded>
    </item>
    {% endfor %}
  </channel>
</rss>
