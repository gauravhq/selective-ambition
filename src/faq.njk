---
layout: base.njk
permalink: /faq/
title: FAQ
pageDescription: Research-based answers on overcommitment, FOMO and JOMO, comparison, saying no, focus, burnout, and ambition, from Selective Ambition by Gaurav Srivastava.
---
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faqs.all %}{"@type":"Question","name":{{ item.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<section class="section"><div class="wrap" style="max-width:820px">
  <div class="eyebrow">FAQ</div>
  <h1>Questions people ask</h1>
  <p class="lead">Short, honest answers on what actually keeps people stuck, each one grounded in well-established research and in <em>{{ site.title }}</em>. Tap a question to open it.</p>

  <nav class="faq-nav" aria-label="FAQ sections">
    {% for group in faqs.groups %}<a href="#{{ group.id }}">{{ group.category }}</a>{% endfor %}
  </nav>

  {% for group in faqs.groups %}
  <h2 class="faq-h" id="{{ group.id }}" style="color:var(--ink);margin:34px 0 6px">{{ group.category }}</h2>
  <div class="rule"><span></span></div>
  {% for item in group.items %}
  <details class="faq" id="q-{{ group.id }}-{{ loop.index }}">
    <summary>{{ item.q }}</summary>
    <div class="faq-a">
      <p>{{ item.a }}</p>
      {% if item.link %}<p class="faq-more"><a href="{{ item.link }}">{{ item.linkText or "More on the blog" }}</a></p>{% endif %}
    </div>
  </details>
  {% endfor %}
  {% endfor %}

  <div class="buybar">
    <p><strong>Ready to read it?</strong> <em>{{ site.title }}: {{ site.subtitle }}</em> by {{ site.author }}.</p>
    <div class="btn-row"><a class="btn" href="{{ site.amazon.kindle }}" target="_blank" rel="noopener">Get it on Kindle</a>
    <a class="btn ghost" href="/book/">About the book</a></div>
  </div>
</div></section>
<script>
  /* Search links to a single question. Open that accordion and put it in view, instead of
     landing on a collapsed row the reader then has to hunt for. */
  (function () {
    function openTarget() {
      var id = location.hash.slice(1);
      if (!id) return;
      var el = document.getElementById(id);
      if (!el) return;
      var d = el.tagName === "DETAILS" ? el : el.closest("details");
      if (d) { d.open = true; d.scrollIntoView({ block: "center" }); }
    }
    window.addEventListener("hashchange", openTarget);
    openTarget();
  })();
</script>
